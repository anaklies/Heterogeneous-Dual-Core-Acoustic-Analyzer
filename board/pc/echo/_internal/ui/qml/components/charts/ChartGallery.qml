// ChartGallery - QA / screenshot page for the chart components.
//
// Plain Item page (no window, no backend): every value is deterministic
// synthetic display data generated in QML below. The page is clearly labelled
// "chart gallery - synthetic display data"; the two rasters are generated by
// _selftest/make_demo_rasters.py and are demo-only. Do not wire page code to
// this file; it exists so the components can be inspected and screenshotted.
import QtQuick
import QtQuick.Window

Item {
    id: gallery
    objectName: "chartGallery"

    // The preview harness can override these with real image:// provider URLs.
    property string demoHeatmapUrl: Qt.resolvedUrl("demo/heatmap_demo.png")
    property string demoPolarUrl: Qt.resolvedUrl("demo/polar_demo.png")

    // deterministic synthetic demo state
    property var wfChannels: []
    property var wfGaps: [{ start: 780, end: 900 }, { start: 1900, end: 1960 }]
    property var psdSeries: []
    property var barCategories: []
    property var meters: []
    property var timelineEvents: []
    property real timelinePosition: 0.35
    property var timelineSelection: ({ start: 0.20, end: 0.42 })
    property var timelineGaps: [{ start: 0.60, end: 0.63 }]

    // interaction counters (used by the offscreen load check)
    property var waterfallFrames: []
    property int wfSeekCount: 0
    property int wfCursorCount: 0
    property int wfSelectionCount: 0
    property int wfViewResetCount: 0
    property int lineCursorCount: 0
    property int linePointCount: 0
    property int heatmapClickCount: 0
    property int timelineSeekCount: 0
    property int timelineSelectionCount: 0

    Component.onCompleted: buildDemoData()

    function frac(v) {
        var x = Math.sin(v * 12.9898) * 43758.5453;
        return x - Math.floor(x);
    }

    function round3(v) { return Math.round(v * 1000) / 1000; }

    function buildWaveform() {
        var sr = 48000;
        var n = 2400;
        var colors = Theme.channelColors;
        var names = ["CH1", "CH2", "CH3", "CH4", "CH5", "CH6"];
        var out = [];
        for (var c = 0; c < 6; c++) {
            var vals = [];
            for (var i = 0; i < n; i++) {
                var t = i / sr;
                var v = (0.62 - c * 0.05) * Math.sin(2 * Math.PI * (440 + c * 37) * t + c * 0.42)
                    + 0.16 * Math.sin(2 * Math.PI * (1320 + c * 11) * t + c * 1.1)
                    + 0.05 * Math.sin(2 * Math.PI * 61 * t)
                    + 0.02 * (frac(i * 0.37 + c * 11.3) - 0.5);
                vals.push(round3(v));
            }
            out.push({ name: names[c], color: colors[c], visible: true, values: vals });
        }
        return out;
    }

    function buildPsd() {
        var colors = Theme.channelColors;
        var out = [];
        for (var c = 0; c < 3; c++) {
            var pts = [];
            var n = 180;
            for (var i = 0; i < n; i++) {
                var tt = i / (n - 1);
                var f = 20 * Math.pow(1000, tt); // 20 Hz .. 20 kHz, log spaced
                var y = -34 - 16 * Math.pow(Math.log(f / 800) / Math.LN10, 2) - c * 2.5
                    + 2.6 * Math.sin(i * 0.35 + c) + 1.2 * (frac(i * 1.7 + c * 9.1) - 0.5);
                pts.push([Math.round(f * 10) / 10, Math.round(y * 10) / 10]);
            }
            if (c === 0) pts.unshift([0, -100]); // log-axis guard demo: clipped + badge
            out.push({
                name: ["CH1 PSD", "CH2 PSD", "Peak hold"][c],
                color: colors[c],
                points: pts,
                width: c === 2 ? 1 : 1.2,
                dashed: c === 2,
                fill: c === 0,
                visible: true
            });
        }
        return out;
    }

    function buildBars() {
        var freqs = [31.5, 63, 125, 250, 500, 1000, 2000, 4000, 8000, 16000];
        var labels = ["31", "63", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"];
        var levels = [-52.4, -45.1, -38.7, -33.2, -29.5, -26.8, -31.4, -39.0, -47.3, -55.6];
        var colors = Theme.channelColors;
        var out = [];
        for (var i = 0; i < freqs.length; i++) {
            out.push({
                label: labels[i],
                value: levels[i],
                centerFrequency: freqs[i],
                color: colors[i % colors.length],
                valid: i !== 3
            });
        }
        return out;
    }

    function buildMeters() {
        var colors = Theme.channelColors;
        var vals = [-12.3, -18.4, null, -6.7, -24.1, -9.0];
        var peaks = [-9.1, -15.2, null, -3.9, -20.0, -6.0];
        var out = [];
        for (var i = 0; i < 6; i++) {
            out.push({
                label: "CH" + (i + 1),
                color: colors[i],
                value: vals[i],
                peak: peaks[i],
                valid: vals[i] !== null,
                clip: i === 3
            });
        }
        return out;
    }

    function buildEvents() {
        return [
            { position: 0.05, label: "recording started", kind: "info" },
            { position: 0.22, label: "level warning", kind: "warn" },
            { position: 0.37, label: "clipping", kind: "error" },
            { position: 0.50, label: "task complete", kind: "info" },
            { position: 0.63, label: "gap", kind: "warn" },
            { position: 0.78, label: "export", kind: "info" },
            { position: 0.90, label: "recording stopped", kind: "info" }
        ];
    }

    function buildDemoData() {
        wfChannels = buildWaveform();
        var frames = [];
        for (var r = 0; r < 40; r++) {
            var pts = [], time = r * 0.1;
            for (var b = 0; b < 100; b++) {
                var f = 20 * Math.pow(1000, b / 99);
                var lf = Math.log(f) / Math.LN10;
                var db = -92 + 54 * Math.exp(-Math.pow((lf - 2.12) / 0.19, 2)) * Math.exp(-time * 0.25)
                    + 46 * Math.exp(-Math.pow((lf - 2.78) / 0.13, 2)) * Math.exp(-time * 0.52)
                    + 32 * Math.exp(-Math.pow((lf - 3.32) / 0.2, 2)) * Math.exp(-time * 0.8)
                    + 3 * Math.sin(b * 1.2 + r * 0.6);
                pts.push([f, db]);
            }
            frames.push({time: time, points: pts});
        }
        waterfallFrames = frames;
        psdSeries = buildPsd();
        barCategories = buildBars();
        meters = buildMeters();
        timelineEvents = buildEvents();
    }

    Rectangle {
        anchors.fill: parent
        color: Theme.appBg
    }

    Flickable {
        id: flick
        anchors.fill: parent
        contentWidth: width
        contentHeight: content.height + 32
        clip: true
        boundsBehavior: Flickable.StopAtBounds

        Column {
            id: content
            x: 16
            y: 16
            width: flick.width - 32
            spacing: 10

            // ---------------------------------------------------------- header
            Item {
                width: content.width
                height: 48

                Text {
                    id: galleryTitle
                    width: parent.width
                    elide: Text.ElideRight
                    text: "Acoustic analysis / chart laboratory"
                    color: Theme.textPrimary
                    font.family: Theme.fontFamily
                    font.pixelSize: Theme.sizeBody + 3
                    font.bold: true
                    anchors.left: parent.left
                    anchors.top: parent.top
                }
                Text {
                    width: parent.width
                    elide: Text.ElideRight
                    text: "Synthetic display data for visual verification. Not measured acoustic data."
                    color: Theme.textSecondary
                    font.family: Theme.fontFamily
                    font.pixelSize: Theme.sizeSmall
                    anchors.left: parent.left
                    anchors.top: galleryTitle.bottom
                    anchors.topMargin: 4
                }
            }

            // ---------------------------------------------------------- waveform
            Rectangle {
                width: content.width
                height: 260
                color: Theme.panelBg
                border.color: Theme.border
                border.width: 1
                radius: Theme.radiusPanel
                clip: true

                Text {
                    id: wfTitle
                    x: 12
                        width: parent.width - 24
                        elide: Text.ElideRight
                    y: 9
                    text: "Waveform / six channels"
                    color: Theme.textPrimary
                    font.family: Theme.fontFamily
                    font.pixelSize: Theme.sizeSmall
                }
                WaveformChart {
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.top: wfTitle.bottom
                    anchors.bottom: parent.bottom
                    anchors.margins: 6
                    anchors.topMargin: 4
                    objectName: "galleryWaveform"
                    channels: gallery.wfChannels
                    gaps: gallery.wfGaps
                    sampleRate: 48000
                    startSampleIndex: "17592186044416"
                    xMode: "time"
                    stacked: true
                    cursorA: 0.32
                    cursorB: 0.61
                    selection: ({ start: 0.42, end: 0.55 })
                    yUnit: "FS"
                    onSeekRequested: function (p) { gallery.wfSeekCount++ }
                    onCursorChanged: function (a, b) { gallery.wfCursorCount++ }
                    onSelectionEdited: function (a, b) { gallery.wfSelectionCount++ }
                    onViewResetRequested: { gallery.wfViewResetCount++ }
                }
            }

            // ---------------------------------------------------------- line + bar
            Row {
                width: content.width
                height: 300
                spacing: 10

                Rectangle {
                    width: (parent.width - 10) * 0.62
                    height: parent.height
                    color: Theme.panelBg
                    border.color: Theme.border
                    border.width: 1
                    radius: Theme.radiusPanel
                    clip: true

                    Text {
                        id: lineTitle
                        x: 12
                        width: parent.width - 24
                        elide: Text.ElideRight
                        y: 9
                        text: "Spectrum / logarithmic frequency"
                        color: Theme.textPrimary
                        font.family: Theme.fontFamily
                        font.pixelSize: Theme.sizeSmall
                    }
                    LineChart {
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: lineTitle.bottom
                        anchors.bottom: parent.bottom
                        anchors.margins: 6
                        anchors.topMargin: 4
                        objectName: "galleryLine"
                        series: gallery.psdSeries
                        xAxis: ({ min: 20, max: 20000, scale: "log", label: "Frequency", unit: "Hz" })
                        yAxis: ({ min: -90, max: 0, scale: "linear", label: "PSD", unit: "dBFS" })
                        cursorAX: 1000
                        cursorBX: 4000
                        referenceLines: ([{ y: -60, label: "-60 dBFS", color: Theme.plotTextDim, dashed: true }])
                        referenceBands: ([{ y0: -55, y1: -45, color: Theme.accent, opacity: 0.10, label: "target band" }])
                        showLegend: true
                        onCursorChanged: function (a, b) { gallery.lineCursorCount++ }
                        onPointClicked: function (x, y) { gallery.linePointCount++ }
                    }
                }

                Rectangle {
                    width: (parent.width - 10) * 0.38
                    height: parent.height
                    color: Theme.panelBg
                    border.color: Theme.border
                    border.width: 1
                    radius: Theme.radiusPanel
                    clip: true

                    Text {
                        id: barTitle
                        x: 12
                        width: parent.width - 24
                        elide: Text.ElideRight
                        y: 9
                        text: "Octave spectrum / band levels"
                        color: Theme.textPrimary
                        font.family: Theme.fontFamily
                        font.pixelSize: Theme.sizeSmall
                    }
                    BarChart {
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: barTitle.bottom
                        anchors.bottom: parent.bottom
                        anchors.margins: 6
                        anchors.topMargin: 4
                        objectName: "galleryBar"
                        displayMode: "bars"
                        uniformColor: true
                        categories: gallery.barCategories
                        xMode: "centerFrequency"
                        yAxis: ({ min: -80, max: 0, scale: "linear", label: "Band level", unit: "dBFS" })
                        limitLine: ({ value: -20, label: "limit", color: Theme.error })
                        referenceValues: ([{ value: -30, label: "ref", color: Theme.info }])
                        valueFormat: "%.1f"
                        xLabel: "Octave band"
                        xUnit: "Hz"
                    }
                }
            }

            // ---------------------------------------------------------- heatmap + polar
            Row {
                width: content.width
                height: 300
                spacing: 10

                Rectangle {
                    width: (parent.width - 10) * 0.62
                    height: parent.height
                    color: Theme.panelBg
                    border.color: Theme.border
                    border.width: 1
                    radius: Theme.radiusPanel
                    clip: true

                    Text {
                        id: heatTitle
                        x: 12
                        width: parent.width - 24
                        elide: Text.ElideRight
                        y: 9
                        text: "Spectrogram / time-frequency energy"
                        color: Theme.textPrimary
                        font.family: Theme.fontFamily
                        font.pixelSize: Theme.sizeSmall
                    }
                    HeatmapChart {
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: heatTitle.bottom
                        anchors.bottom: parent.bottom
                        anchors.margins: 6
                        anchors.topMargin: 4
                        objectName: "galleryHeatmap"
                        imageUrl: gallery.demoHeatmapUrl
                        xAxis: ({ min: 0, max: 10, scale: "linear", label: "Time", unit: "s" })
                        yAxis: ({ min: 20, max: 20000, scale: "log", label: "Frequency", unit: "Hz" })
                        colorScale: ({ min: -86, max: -10, palette: "viridis", label: "PSD", unit: "dBFS" })
                        cursor: ({ x: 4.2, y: 1000 })
                        onPointClicked: function (x, y) { gallery.heatmapClickCount++ }
                    }
                }

                Rectangle {
                    width: (parent.width - 10) * 0.38
                    height: parent.height
                    color: Theme.panelBg
                    border.color: Theme.border
                    border.width: 1
                    radius: Theme.radiusPanel
                    clip: true

                    Text {
                        id: polarTitle
                        x: 12
                        width: parent.width - 24
                        elide: Text.ElideRight
                        y: 9
                        text: "Directional power / azimuth and elevation"
                        color: Theme.textPrimary
                        font.family: Theme.fontFamily
                        font.pixelSize: Theme.sizeSmall
                    }
                    PolarChart {
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: polarTitle.bottom
                        anchors.bottom: parent.bottom
                        anchors.margins: 6
                        anchors.topMargin: 4
                        objectName: "galleryPolar"
                        imageUrl: gallery.demoPolarUrl
                        azimuthRange: ({ min: 0, max: 360 })
                        elevationRange: ({ min: 0, max: 90 })
                        colorScale: ({ min: -40, max: 0, palette: "cividis", label: "Power", unit: "dB" })
                        caption: "Relative directional power - not source separation"
                        projection: "polar"
                    }
                }
            }

            // ---------------------------------------------------------- level meters
            Row {
                width: content.width
                height: 150
                spacing: 10

                Rectangle {
                    width: (parent.width - 10) * 0.46
                    height: parent.height
                    color: Theme.panelBg
                    border.color: Theme.border
                    border.width: 1
                    radius: Theme.radiusPanel
                    clip: true

                    Text {
                        id: meterTitle
                        x: 12
                        width: parent.width - 24
                        elide: Text.ElideRight
                        y: 9
                        text: "LevelMeter - vertical, invalid channel shows dash (never 0 dBFS full scale), clip shape"
                        color: Theme.textPrimary
                        font.family: Theme.fontFamily
                        font.pixelSize: Theme.sizeSmall
                    }
                    LevelMeter {
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: meterTitle.bottom
                        anchors.bottom: parent.bottom
                        anchors.margins: 6
                        anchors.topMargin: 4
                        objectName: "galleryMeterV"
                        meters: gallery.meters
                        scale: ({ min: -60, max: 0, label: "Level", unit: "dBFS" })
                        orientation: "vertical"
                        clipText: "CLIP"
                    }
                }

                Rectangle {
                    width: (parent.width - 10) * 0.54
                    height: parent.height
                    color: Theme.panelBg
                    border.color: Theme.border
                    border.width: 1
                    radius: Theme.radiusPanel
                    clip: true

                    Text {
                        id: meterHTitle
                        x: 12
                        width: parent.width - 24
                        elide: Text.ElideRight
                        y: 9
                        text: "LevelMeter - horizontal orientation, same meter data"
                        color: Theme.textPrimary
                        font.family: Theme.fontFamily
                        font.pixelSize: Theme.sizeSmall
                    }
                    LevelMeter {
                        anchors.left: parent.left
                        anchors.right: parent.right
                        anchors.top: meterHTitle.bottom
                        anchors.bottom: parent.bottom
                        anchors.margins: 6
                        anchors.topMargin: 4
                        objectName: "galleryMeterH"
                        meters: gallery.meters
                        scale: ({ min: -60, max: 0, label: "Level", unit: "dBFS" })
                        orientation: "horizontal"
                        clipText: "CLIP"
                    }
                }
            }

            // ---------------------------------------------------------- timeline
            Rectangle {
                width: content.width
                height: 150
                color: Theme.panelBg
                border.color: Theme.border
                border.width: 1
                radius: Theme.radiusPanel
                clip: true

                Text {
                    id: timelineTitle
                    x: 12
                        width: parent.width - 24
                        elide: Text.ElideRight
                    y: 9
                    text: "TimelineChart - play head, events by kind, selection band, gap region, seek/scrub"
                    color: Theme.textPrimary
                    font.family: Theme.fontFamily
                    font.pixelSize: Theme.sizeSmall
                }
                TimelineChart {
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.top: timelineTitle.bottom
                    anchors.bottom: parent.bottom
                    anchors.margins: 6
                    anchors.topMargin: 4
                    objectName: "galleryTimeline"
                    durationSeconds: 180
                    position: gallery.timelinePosition
                    events: gallery.timelineEvents
                    selection: gallery.timelineSelection
                    gaps: gallery.timelineGaps
                    playing: true
                    onSeekRequested: function (p) {
                        gallery.timelineSeekCount++;
                        gallery.timelinePosition = p;
                    }
                    onSelectionEdited: function (a, b) {
                        gallery.timelineSelectionCount++;
                        gallery.timelineSelection = { start: a, end: b };
                    }
                }
            }

            Rectangle {
                width: content.width
                height: 450
                color: Theme.panelBg
                border.color: Theme.border
                radius: Theme.radiusPanel
                clip: true
                Text {
                    id: waterfallTitle
                    x: 16; y: 12; width: parent.width - 32
                    text: "Spectral waterfall / drag to adjust perspective"
                    color: Theme.textPrimary
                    font.family: Theme.fontFamily
                    font.pixelSize: Math.round(18 * Theme.fontScale)
                    elide: Text.ElideRight
                }
                WaterfallChart {
                    objectName: "galleryWaterfall"
                    anchors.left: parent.left; anchors.right: parent.right
                    anchors.top: waterfallTitle.bottom; anchors.bottom: parent.bottom
                    anchors.margins: 8
                    frames: gallery.waterfallFrames
                    frequencyAxis: ({min: 20, max: 20000, scale: "log", label: "Frequency", unit: "Hz"})
                    timeAxis: ({min: 0, max: 3.9, label: "Time", unit: "s"})
                    colorScale: ({min: -100, max: -20, palette: "viridis", label: "Level", unit: "dBFS"})
                }
            }

            // ---------------------------------------------------------- states
            Row {
                width: content.width
                height: 130
                spacing: 10

                Rectangle {
                    width: (parent.width - 30) / 4
                    height: parent.height
                    color: Theme.panelBg
                    border.color: Theme.border
                    border.width: 1
                    radius: Theme.radiusPanel
                    clip: true

                    WaveformChart {
                        anchors.fill: parent
                        anchors.margins: 6
                        emptyText: "no waveform data"
                        emptyReason: "connect a source or open a recording"
                        interactive: false
                    }
                }

                Rectangle {
                    width: (parent.width - 30) / 4
                    height: parent.height
                    color: Theme.panelBg
                    border.color: Theme.border
                    border.width: 1
                    radius: Theme.radiusPanel
                    clip: true

                    LineChart {
                        anchors.fill: parent
                        anchors.margins: 6
                        busy: true
                        busyText: "loading spectrum..."
                        interactive: false
                    }
                }

                Rectangle {
                    width: (parent.width - 30) / 4
                    height: parent.height
                    color: Theme.panelBg
                    border.color: Theme.border
                    border.width: 1
                    radius: Theme.radiusPanel
                    clip: true

                    HeatmapChart {
                        anchors.fill: parent
                        anchors.margins: 6
                        emptyText: "no STFT image"
                        emptyReason: "image provider returned no raster"
                        interactive: false
                    }
                }

                Rectangle {
                    width: (parent.width - 30) / 4
                    height: parent.height
                    color: Theme.panelBg
                    border.color: Theme.border
                    border.width: 1
                    radius: Theme.radiusPanel
                    clip: true

                    LevelMeter {
                        anchors.fill: parent
                        anchors.margins: 6
                        meters: []
                        scale: ({ min: -60, max: 0, label: "Level", unit: "dBFS" })
                        emptyText: "no channel levels"
                        emptyReason: "signal path idle"
                        interactive: false
                    }
                }
            }
        }
    }
}
