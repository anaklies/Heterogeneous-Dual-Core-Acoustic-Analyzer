{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sixmic.local/pc_backend_v1/control.schema.json",
  "title": "sixmic-analysis v1 control channel envelopes",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "u64string": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "request": {
      "type": "object",
      "required": [
        "protocol",
        "version",
        "requestId",
        "op",
        "args"
      ],
      "additionalProperties": true,
      "properties": {
        "protocol": {
          "const": "sixmic-analysis"
        },
        "version": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "sessionId": {
          "oneOf": [
            {
              "$ref": "#/$defs/sessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "op": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "args": {
          "type": "object",
          "maxProperties": 64
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "messageKey",
        "retryable"
      ],
      "additionalProperties": true,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "messageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retryable": {
          "type": "boolean"
        },
        "detail": {
          "type": "object",
          "maxProperties": 32
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "type",
        "protocol",
        "version",
        "requestId",
        "status"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "response"
        },
        "protocol": {
          "const": "sixmic-analysis"
        },
        "version": {
          "const": 1
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "status": {
          "enum": [
            "ok",
            "accepted",
            "error"
          ]
        },
        "result": {
          "type": "object",
          "maxProperties": 128
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          },
          "else": {
            "required": [
              "result"
            ]
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "type",
        "protocol",
        "version",
        "event",
        "eventId",
        "data"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "event"
        },
        "protocol": {
          "const": "sixmic-analysis"
        },
        "version": {
          "const": 1
        },
        "event": {
          "enum": [
            "jobUpdated",
            "eventAdded",
            "deviceState",
            "configApplied",
            "recordingChanged",
            "streamGap",
            "diagnosticAdded",
            "controlChanged"
          ]
        },
        "eventId": {
          "$ref": "#/$defs/u64string"
        },
        "data": {
          "type": "object",
          "maxProperties": 128
        }
      }
    }
  }
}
